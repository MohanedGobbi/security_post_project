{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../src/shared/*"],
      "@renderer/*": ["../src/renderer/src/*"],
      "@desktop/*": ["../src/renderer/src/*"],
      "@/*": ["../src/renderer/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "../src/shared/**/*", "../src/preload/index.d.ts"]
}
