{
  "name": "security-register",
  "productName": "FacultySecurity",
  "version": "0.1.0",
  "description": "Faculty security management program (Faculty of Law and Political Science, University of Ghardaia)",
  "main": "./out/main/index.js",
  "desktopName": "security-register.desktop",
  "author": {
    "name": "ROWD Tech",
    "email": "noreply@example.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p demo/tsconfig.json",
    "dist": "electron-vite build && electron-builder --win",
    "build:demo": "vite build --config demo/vite.config.ts",
    "dev:demo": "vite --config demo/vite.config.ts",
    "dist:linux": "electron-vite build && electron-builder --linux deb",
    "test": "node --test tests/*.test.ts",
    "version:file": "node scripts/release/write-version.mjs"
  },
  "build": {
    "appId": "com.securityregister.app",
    "productName": "FacultySecurity",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/zxing-wasm/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "tools/start-system.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FacultySecurity",
      "deleteAppDataOnUninstall": false
    },
    "extraResources": [
      {
        "from": "resources",
        "to": "."
      },
      {
        "from": "scripts/linux/updater",
        "to": "updater"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "icon": "tools/linux-icons",
      "maintainer": "ROWD Tech <noreply@example.com>",
      "synopsis": "Faculty security management program",
      "artifactName": "${productName}-${version}-amd64.${ext}",
      "desktop": {
        "entry": {
          "Name": "Faculty Security",
          "Name[ar]": "برنامج إدارة الأمن بالكلية",
          "Name[fr]": "Sécurité de la faculté",
          "Comment": "Faculty security management program",
          "Comment[ar]": "برنامج إدارة الأمن بالكلية - كلية الحقوق والعلوم السياسية، جامعة غرداية",
          "Keywords": "security;visitors;registers;أمن;زوار;سجلات;"
        }
      },
      "syncDesktopName": true
    }
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "zxing-wasm": "^3.1.5"
  },
  "devDependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "i18next": "^26.4.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.20",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "homepage": "https://github.com/MohanedGobbi/security_post_project"
}
